# ============================================================
# GLEAMIO ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in the values.
# Lines starting with # are comments.
# ============================================================

# --- App ---
VITE_APP_NAME=Gleamio
VITE_APP_URL=http://localhost:3000

# --- Demo Mode ---
# Set to "true" to run in demo mode (no backend, local storage only)
VITE_DEMO_MODE=false

# --- Backend / API ---
# Port the Express server listens on
SERVER_PORT=4000
# Secret used to sign JWT tokens (generate a random string, e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-secret
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgresql://gleamio:password@localhost:5432/gleamio

# --- Redis (optional, for real-time collab & sessions) ---
REDIS_URL=redis://localhost:6379

# --- File Storage ---
# "local" or "s3"
STORAGE_DRIVER=local
# Local uploads path (relative to server root)
UPLOAD_DIR=./uploads
# S3 settings (only needed if STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# --- AI Features (optional) ---
# OpenAI API key for AI-powered tools (quiz generation, image gen, TTS, etc.)
OPENAI_API_KEY=
# Anthropic API key (alternative AI provider)
ANTHROPIC_API_KEY=

# --- Asset Library (optional) ---
# Unsplash access key for stock photos
UNSPLASH_ACCESS_KEY=
# Pexels API key
PEXELS_API_KEY=
# Giphy API key for GIF search
GIPHY_API_KEY=

# --- Email (optional, for invites & notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@gleamio.app

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
